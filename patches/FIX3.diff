+; FIX3: write/close a sibling temporary file before renaming the original.
+; Existing KR3SAVE.TMP / KR3SAVE.BAK are never overwritten.
+SaveMyself proc near
+        cld
+        push ds
+        pop es
+        push ds
+        mov ds,ds:[2ch]
+        xor si,si
+@@Env:  lodsb
+        or al,al
+        jne @@Env
+        lodsb
+        or al,al
+        jne @@Env
+        add si,2
+        lea di,SavePath
+        mov cx,127
+@@Path: lodsb
+        stosb
+        or al,al
+        je @@PathDone
+        loop @@Path
+        pop ds
+        jmp @@Error
+@@PathDone:
+        pop ds
+        lea si,SavePath
+        lea di,SaveTemp
+        xor bx,bx
+@@Copy: lodsb
+        stosb
+        cmp al,92
+        jne @@NotSlash
+        mov bx,di
+@@NotSlash:
+        or al,al
+        jne @@Copy
+        or bx,bx
+        je @@Error
+        cmp bx,offset SaveTemp+116
+        ja @@Error
+        mov di,bx
+        lea si,SaveTempName
+        mov cx,12
+        rep movsb
+        lea si,SaveTemp
+        lea di,SaveBackup
+        mov cx,128
+        rep movsb
+        mov di,bx
+        sub di,offset SaveTemp
+        add di,offset SaveBackup
+        lea si,SaveBackupName
+        mov cx,12
+        rep movsb
+        ; Refuse to replace a read-only executable.
+        lea dx,SavePath
+        mov ax,4300h
+        int 21h
+        jc @@Error
+        test cx,1
+        jnz @@Error
+        mov SaveAttributes,cx
+        lea dx,SaveBackup
+        mov ax,4300h
+        int 21h
+        jnc @@Error
+        cmp ax,2
+        jne @@Error
+        lea dx,SaveTemp
+        xor cx,cx
+        mov ax,5b00h
+        int 21h
+        jc @@Error
+        mov bx,ax
+        mov dx,100h
+        mov cx,EndProgram
+        sub cx,100h
+        mov ah,40h
+        int 21h
+        jc @@WriteError
+        cmp ax,cx
+        jne @@WriteError
+        mov ah,3eh
+        int 21h
+        jc @@RemoveTemp
+        lea dx,SavePath
+        lea di,SaveBackup
+        mov ah,56h
+        int 21h
+        jc @@RemoveTemp
+        lea dx,SaveTemp
+        lea di,SavePath
+        mov ah,56h
+        int 21h
+        jnc @@Committed
+        ; Roll back. If this also fails, preserve the backup for recovery.
+        lea dx,SaveBackup
+        lea di,SavePath
+        mov ah,56h
+        int 21h
+        jc @@Recovery
+        jmp @@RemoveTemp
+@@Committed:
+        lea dx,SavePath
+        mov cx,SaveAttributes
+        mov ax,4301h
+        int 21h
+        jc @@Recovery
+        lea dx,SaveBackup
+        mov ah,41h
+        int 21h
+        jc @@Recovery
+        lea dx,Mes_Saved
+        mov ah,9
+        int 21h
+        xor al,al
+        call Exit
+@@WriteError:
+        mov ah,3eh
+        int 21h
+@@RemoveTemp:
+        lea dx,SaveTemp
+        mov ah,41h
+        int 21h
+@@Error:
+        lea dx,Mes_SaveError
+        jmp @@Report
+@@Recovery:
+        lea dx,Mes_SaveRecovery
+@@Report:
+        mov ah,9
+        int 21h
+        mov al,1
+        call Exit
+SaveMyself endp
